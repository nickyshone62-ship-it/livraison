# =============================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (LivraisonOuaga)
# =============================================================

# 1. DATABASE_URL: Pooler Connection String (Port 6543) for Vercel & Production
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection String (Port 5432) for Prisma Migrations & Seeds
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT Secret Key
JWT_SECRET="ouagadougou-livraison-secret-key-2026"
