datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// MODÈLES DE LA BASE SUPABASE EXISTANTE (18 TABLES 100% CONFORMES RELATIONS)
// ==============================================================================

model Profile {
  id            String   @id @db.Uuid
  role          String   @default("client") // client, driver, admin
  fullName      String?  @map("full_name")
  phone         String?
  email         String?
  avatarUrl     String?  @map("avatar_url")
  city          String?
  address       String?
  accountStatus String   @default("pending") @map("account_status") // pending, active, suspended, rejected
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  driverProfile        DriverProfile?
  payments             Payment[]
  subscriptions        Subscription[]
  clientDeliveries     DeliveryRequest[]       @relation("ClientRequests")
  reportsGiven         Report[]                @relation("ReporterUser")
  reportsReceived      Report[]                @relation("ReportedUser")
  reviewsGiven         Review[]                @relation("ReviewerUser")
  notifications        Notification[]          @relation("UserNotifications")
  adminActions         AdminAction[]           @relation("AdminActions")
  clientConversations  Conversation[]          @relation("ClientConversations")
  sentMessages         Message[]               @relation("SentMessages")

  @@map("profiles")
}

model DriverProfile {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  profile            Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus String    @default("pending") @map("verification_status") // pending, under_review, approved, rejected, suspended
  isAvailable        Boolean   @default(false) @map("is_available")
  averageRating      Decimal   @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalRatings       Int       @default(0) @map("total_ratings")
  totalDeliveries    Int       @default(0) @map("total_deliveries")
  approvedAt         DateTime? @map("approved_at")
  approvedBy         String?   @map("approved_by") @db.Uuid
  rejectionReason    String?   @map("rejection_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  vehicles           Vehicle[]
  documents          DriverDocument[]
  offers             DeliveryOffer[]         @relation("DriverOffers")
  assignments        DeliveryAssignment[]    @relation("DriverAssignments")
  trackingLogs       DeliveryTracking[]      @relation("DriverTracking")
  reviews            Review[]                @relation("ReviewedDriverProfile")
  conversations      Conversation[]          @relation("DriverConversations")

  @@map("driver_profiles")
}

model Vehicle {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId           String        @map("driver_id") @db.Uuid
  driver             DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleType        String        @map("vehicle_type") // motorcycle, car, van, truck, bicycle, other
  brand              String?
  model              String?
  registrationNumber String?       @map("registration_number")
  color              String?
  year               Int?
  isPrimary          Boolean       @default(true) @map("is_primary")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @map("updated_at")

  @@map("vehicles")
}

model DriverDocument {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId        String        @map("driver_id") @db.Uuid
  driver          DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documentType    String        @map("document_type") // identity_card, driver_license, vehicle_document, other
  documentNumber  String?       @map("document_number")
  fileUrl         String        @map("file_url")
  status          String        @default("pending") // pending, approved, rejected, expired
  rejectionReason String?       @map("rejection_reason")
  expiresAt       DateTime?     @map("expires_at") @db.Date
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")

  @@map("driver_documents")
}

model Payment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentType          String   @map("payment_type") // registration, subscription
  amount               Decimal  @db.Decimal(10, 2)
  currency             String   @default("XOF")
  paymentMethod        String   @map("payment_method") // orange_money, moov_money, wave
  recipientPhone       String?  @map("recipient_phone")
  transactionReference String?  @map("transaction_reference")
  status               String   @default("pending") // pending, approved, rejected, expired, cancelled
  notes                String?
  reviewedBy           String?  @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime? @map("reviewed_at")
  rejectionReason      String?  @map("rejection_reason")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @map("updated_at")

  subscriptions        Subscription[]

  @@map("payments")
}

model Subscription {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId       String?   @map("payment_id") @db.Uuid
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount          Decimal   @default(1000) @db.Decimal(10, 2)
  currency        String    @default("XOF")
  status          String    @default("pending") // pending, active, expired, rejected, cancelled
  startsAt        DateTime? @map("starts_at")
  expiresAt       DateTime? @map("expires_at")
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@map("subscriptions")
}

model DeliveryRequest {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String   @map("client_id") @db.Uuid
  client                  Profile  @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  pickupAddress           String   @map("pickup_address")
  pickupCity              String?  @map("pickup_city")
  pickupLatitude          Float?   @map("pickup_latitude")
  pickupLongitude         Float?   @map("pickup_longitude")
  pickupInstructions       String?  @map("pickup_instructions")
  destinationAddress      String   @map("destination_address")
  destinationCity         String?  @map("destination_city")
  destinationLatitude     Float?   @map("destination_latitude")
  destinationLongitude    Float?   @map("destination_longitude")
  destinationInstructions String?  @map("destination_instructions")
  recipientName           String   @map("recipient_name")
  recipientPhone          String   @map("recipient_phone")
  packageDescription      String   @map("package_description")
  packageCategory         String?  @map("package_category")
  packageWeight           Decimal? @map("package_weight") @db.Decimal(8, 2)
  packageQuantity         Int      @default(1) @map("package_quantity")
  packageSize             String?  @map("package_size")
  requestedDate           DateTime? @map("requested_date") @db.Date
  requestedTime           String?  @map("requested_time")
  additionalInstructions  String?  @map("additional_instructions")
  status                  String   @default("pending") // pending, searching_driver, driver_selected, driver_accepted, driver_arriving, package_picked_up, in_transit, delivered, completed, cancelled, failed
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @map("updated_at")

  offers                  DeliveryOffer[]
  assignments             DeliveryAssignment[]
  trackingLogs            DeliveryTracking[]
  statusHistory           DeliveryStatusHistory[]
  conversations           Conversation[]
  reviews                 Review[]
  reports                 Report[]

  @@map("delivery_requests")
}

model DeliveryOffer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId        String          @map("delivery_id") @db.Uuid
  deliveryRequest   DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId          String          @map("driver_id") @db.Uuid
  driver            DriverProfile   @relation("DriverOffers", fields: [driverId], references: [id], onDelete: Cascade)
  proposedPrice     Decimal         @map("proposed_price") @db.Decimal(10, 2)
  estimatedDuration Int?            @map("estimated_duration")
  message           String?
  status            String          @default("pending") // pending, accepted, rejected, withdrawn, expired
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @map("updated_at")

  assignments       DeliveryAssignment[]

  @@map("delivery_offers")
}

model DeliveryAssignment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId  String          @map("delivery_id") @db.Uuid
  delivery    DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId    String          @map("driver_id") @db.Uuid
  driver      DriverProfile   @relation("DriverAssignments", fields: [driverId], references: [id], onDelete: Cascade)
  offerId     String?         @map("offer_id") @db.Uuid
  offer       DeliveryOffer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  assignedAt  DateTime        @default(now()) @map("assigned_at")
  acceptedAt  DateTime?       @map("accepted_at")
  startedAt   DateTime?       @map("started_at")
  pickedUpAt  DateTime?       @map("picked_up_at")
  deliveredAt DateTime?       @map("delivered_at")
  completedAt DateTime?       @map("completed_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @map("updated_at")

  @@map("delivery_assignments")
}

model DeliveryTracking {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String          @map("delivery_id") @db.Uuid
  delivery   DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driverId   String          @map("driver_id") @db.Uuid
  driver     DriverProfile   @relation("DriverTracking", fields: [driverId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("delivery_tracking")
}

model DeliveryStatusHistory {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String          @map("delivery_id") @db.Uuid
  delivery   DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     String
  changedBy  String?         @map("changed_by") @db.Uuid
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("delivery_status_history")
}

model Conversation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId String?          @map("delivery_id") @db.Uuid
  delivery   DeliveryRequest? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  clientId   String           @map("client_id") @db.Uuid
  client     Profile          @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  driverId   String           @map("driver_id") @db.Uuid
  driver     DriverProfile    @relation("DriverConversations", fields: [driverId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now()) @map("created_at")

  messages   Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.Uuid
  sender         Profile      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("messages")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      Profile  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String?
  relatedId String?  @map("related_id") @db.Uuid
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Review {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId       String          @map("delivery_id") @db.Uuid
  delivery         DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reviewerId       String          @map("reviewer_id") @db.Uuid
  reviewer         Profile         @relation("ReviewerUser", fields: [reviewerId], references: [id])
  reviewedDriverId String          @map("reviewed_driver_id") @db.Uuid
  reviewedDriver   DriverProfile   @relation("ReviewedDriverProfile", fields: [reviewedDriverId], references: [id])
  rating           Int
  comment          String?
  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("reviews")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  reporter       Profile          @relation("ReporterUser", fields: [reporterId], references: [id])
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  reportedUser   Profile?         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  deliveryId     String?          @map("delivery_id") @db.Uuid
  delivery       DeliveryRequest? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  reason         String
  description    String?
  status         String           @default("pending") // pending, investigating, resolved, rejected
  reviewedBy     String?          @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at")
  resolutionNote String?          @map("resolution_note")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")

  @@map("reports")
}

model AdminAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  admin       Profile  @relation("AdminActions", fields: [adminId], references: [id])
  actionType  String   @map("action_type")
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("admin_actions")
}

model PlatformSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey   String   @map("setting_key")
  settingValue Json     @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("platform_settings")
}
